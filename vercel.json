{
  "redirects": [
    {
      "source": "/academy/workspace",
      "destination": "https://academy.digitalburj.com/",
      "permanent": true
    },
    {
      "source": "/AcademyWorkspace.dc.html",
      "destination": "https://academy.digitalburj.com/",
      "permanent": true
    },
    {
      "source": "/Homepage.dc.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/BusinessOS.dc.html",
      "destination": "/business-os",
      "permanent": true
    },
    {
      "source": "/BusinessAI.dc.html",
      "destination": "/business-ai",
      "permanent": true
    },
    {
      "source": "/Growth.dc.html",
      "destination": "/growth",
      "permanent": true
    },
    {
      "source": "/Studio.dc.html",
      "destination": "/studio",
      "permanent": true
    },
    {
      "source": "/Industries.dc.html",
      "destination": "/industries",
      "permanent": true
    },
    {
      "source": "/Academy.dc.html",
      "destination": "/academy",
      "permanent": true
    },
    {
      "source": "/Talent.dc.html",
      "destination": "/talent",
      "permanent": true
    },
    {
      "source": "/Jobs.dc.html",
      "destination": "/jobs",
      "permanent": true
    },
    {
      "source": "/Pricing.dc.html",
      "destination": "/pricing",
      "permanent": true
    },
    {
      "source": "/Company.dc.html",
      "destination": "/company",
      "permanent": true
    },
    {
      "source": "/Solutions.dc.html",
      "destination": "/solutions",
      "permanent": true
    },
    {
      "source": "/Portfolio.dc.html",
      "destination": "/portfolio",
      "permanent": true
    },
    {
      "source": "/GetStarted.dc.html",
      "destination": "/get-started",
      "permanent": true
    },
    {
      "source": "/Contact.dc.html",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/Insights.dc.html",
      "destination": "/insights",
      "permanent": true
    },
    {
      "source": "/Article.dc.html",
      "has": [
        {
          "type": "query",
          "key": "a",
          "value": "(?<slug>.+)"
        }
      ],
      "destination": "/insights/:slug",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(fonts|vendor)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(media|brand|industry|insight)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "academy.digitalburj.com"
        }
      ],
      "destination": "/AcademyApp.dc.html"
    },
    {
      "source": "/signin",
      "has": [
        {
          "type": "host",
          "value": "academy.digitalburj.com"
        }
      ],
      "destination": "/AcademyApp.dc.html"
    },
    {
      "source": "/signup",
      "has": [
        {
          "type": "host",
          "value": "academy.digitalburj.com"
        }
      ],
      "destination": "/AcademyApp.dc.html"
    },
    {
      "source": "/verify",
      "has": [
        {
          "type": "host",
          "value": "academy.digitalburj.com"
        }
      ],
      "destination": "/AcademyApp.dc.html"
    },
    {
      "source": "/forgot",
      "has": [
        {
          "type": "host",
          "value": "academy.digitalburj.com"
        }
      ],
      "destination": "/AcademyApp.dc.html"
    },
    {
      "source": "/reset",
      "has": [
        {
          "type": "host",
          "value": "academy.digitalburj.com"
        }
      ],
      "destination": "/AcademyApp.dc.html"
    },
    {
      "source": "/welcome",
      "has": [
        {
          "type": "host",
          "value": "academy.digitalburj.com"
        }
      ],
      "destination": "/AcademyApp.dc.html"
    },
    {
      "source": "/redeem",
      "has": [
        {
          "type": "host",
          "value": "academy.digitalburj.com"
        }
      ],
      "destination": "/AcademyApp.dc.html"
    },
    {
      "source": "/",
      "destination": "/Homepage.dc.html"
    },
    {
      "source": "/business-os",
      "destination": "/BusinessOS.dc.html"
    },
    {
      "source": "/business-ai",
      "destination": "/BusinessAI.dc.html"
    },
    {
      "source": "/growth",
      "destination": "/Growth.dc.html"
    },
    {
      "source": "/studio",
      "destination": "/Studio.dc.html"
    },
    {
      "source": "/industries",
      "destination": "/Industries.dc.html"
    },
    {
      "source": "/academy",
      "destination": "/Academy.dc.html"
    },
    {
      "source": "/talent",
      "destination": "/Talent.dc.html"
    },
    {
      "source": "/jobs",
      "destination": "/Jobs.dc.html"
    },
    {
      "source": "/pricing",
      "destination": "/Pricing.dc.html"
    },
    {
      "source": "/company",
      "destination": "/Company.dc.html"
    },
    {
      "source": "/solutions",
      "destination": "/Solutions.dc.html"
    },
    {
      "source": "/portfolio",
      "destination": "/Portfolio.dc.html"
    },
    {
      "source": "/get-started",
      "destination": "/GetStarted.dc.html"
    },
    {
      "source": "/contact",
      "destination": "/Contact.dc.html"
    },
    {
      "source": "/insights",
      "destination": "/Insights.dc.html"
    },
    {
      "source": "/insights/:slug",
      "destination": "/Article.dc.html"
    }
  ]
}
