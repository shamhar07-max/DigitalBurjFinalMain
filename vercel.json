    },
    {
      "source": "/get-started",
      "destination": "/GetStarted.dc.html",
      "permanent": true
    },
    {
      "source": "/insights/:slug",
      "destination": "/Article.dc.html?a=:slug",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(fonts|vendor)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(media|brand|industry|insight)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}